# Public site URL — used for metadataBase, canonical/hreflang URLs, the
# sitemap/robots routes (see lib/seo.ts) and the Stripe success/cancel
# redirects (lib/cart/checkout.ts). The app falls back to
# http://localhost:3000 when unset, so set it on the host: the *.netlify.app
# URL at first, the real domain once one is connected (with protocol, no
# trailing slash). Every canonical/OG/sitemap URL derives from this one var,
# nothing else to change. NEXT_PUBLIC_ values are inlined at build time, so
# redeploy after changing it.
NEXT_PUBLIC_SITE_URL=

# Commerce backend selector. Empty or unset means "sanity" (the live catalog) —
# leaving it blank, as here, is the normal setup. ONLY the exact value
# "fixtures" switches to the built-in demo products (no credentials required;
# dev/test-only override, e.g. COMMERCE_SOURCE=fixtures). Any other value is
# also treated as "sanity".
COMMERCE_SOURCE=

# Sanity project — public (non-secret) identifiers. The real values have a
# documented fallback default in sanity/env.ts, so these can stay blank here:
# empty or unset both fall back to that default.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Only required if the Sanity dataset is private; this project's dataset is
# public read-only, so leave unset.
# SANITY_READ_TOKEN=

# Server-only write access, used by the Stripe webhook
# (app/api/stripe/webhook/route.ts marks a purchased piece sold).
# Needs Editor/Create permissions on the dataset — a different token than
# SANITY_READ_TOKEN above. Never prefix NEXT_PUBLIC_; the app fails safe
# (never throws, never logs the token) when this is unset — see
# lib/sanity/write-client.ts. (Contact messages no longer use it: they are
# stored in Firestore, see the Firebase block below.)
SANITY_WRITE_TOKEN=

# Stripe Checkout (Day 4) — test-mode keys unblock all development at $0.
# Never commit real (live) values. STRIPE_SECRET_KEY must never be prefixed
# NEXT_PUBLIC_ (that prefix ships the value into the browser bundle); the
# app fails safe (never throws, never logs the key) when it's unset — see
# lib/commerce/stripe/client.ts.
# It is also the payments switch (lib/commerce/stripe/config.ts): while it is
# unset the cart shows "Apartar por mensaje" (a link to the contact form)
# instead of the checkout button, and the checkout Server Action refuses.
# Setting it and redeploying turns online payments on, with no code change.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for the Stripe CLI/Dashboard webhook endpoint
# (app/api/stripe/webhook/route.ts). Required to mark a purchased piece
# sold automatically — without it every webhook request is rejected (400)
# and pieces must be flipped to "sold" manually in Studio. Never prefix
# NEXT_PUBLIC_; never log this value.
STRIPE_WEBHOOK_SECRET=

# Firebase Admin SDK (server-only) — Firestore (contact messages, admin data)
# and Auth session cookies for the admin panel (/admin). Service-account
# values from Firebase console > Project settings > Service accounts >
# "Generate new private key". Never prefix NEXT_PUBLIC_; never commit real
# values; delete the downloaded JSON key once copied. FIREBASE_PRIVATE_KEY is
# the PEM on one line with literal \n sequences (real newlines also work). The
# app fails safe (never throws, never logs these values) when any is unset:
# the contact form answers with a server error and /admin login is refused —
# see lib/admin/firebase/admin.ts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated emails allowed into /admin, e.g. "a@x.com,b@y.com"
# (case-insensitive). Each must also be a VERIFIED Firebase Auth user. Empty
# or unset means nobody can sign in (fails closed). It is read on every admin
# request (never cached), so a removal applies as soon as the new environment
# is live (on Netlify, after a redeploy); to lock someone out immediately,
# disable their user in Firebase Authentication.
ADMIN_EMAILS=

# Firebase web app config for the /admin login form (client-side). Public by
# design (these identify the project, they grant no access — Firestore rules
# deny all clients and the server enforces the allowlist). Firebase console >
# Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
